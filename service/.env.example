# 敏感配置：复制为 .env 后填写，.env 不提交到仓库。
MYSQL_USERNAME=root
MYSQL_PASSWORD=
REDIS_PASSWORD=
# JWT 签名密钥，至少 32 字节；可用 openssl rand -hex 32 生成
JWT_SECRET=

# 以下均为可选覆盖；部署环境里通过环境变量覆盖 config.yaml。
# APP_ENV=dev
# SERVER_ADDR=:8888

# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=xqyun
# 完整 DSN 优先于上面的分项配置
# MYSQL_DSN=root:password@tcp(127.0.0.1:3306)/xqyun?charset=utf8mb4&parseTime=True&loc=Local

# REDIS_ENABLED=true
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_POOL_SIZE=10

# JWT_ISSUER=xiaoque-admin
# Refresh Token HttpOnly Cookie
# JWT_COOKIE_NAME=xqyun_admin_refresh
# JWT_COOKIE_PATH=/api/v1/admin
# JWT_COOKIE_DOMAIN=
# 生产环境 HTTPS 必须设为 true
# JWT_COOKIE_SECURE=false
# JWT_COOKIE_SAME_SITE=Lax

# 可选：按客户端覆盖 audience / token_type / TTL
# JWT_ADMIN_AUDIENCE=admin-api
# JWT_ADMIN_TOKEN_TYPE=admin
# JWT_ADMIN_ACCESS_TTL=15m
# JWT_ADMIN_REFRESH_TTL=168h
# JWT_FRONTEND_AUDIENCE=frontend-api
# JWT_FRONTEND_TOKEN_TYPE=frontend
# JWT_FRONTEND_ACCESS_TTL=30m
# JWT_FRONTEND_REFRESH_TTL=720h

# 生产环境设为 production 后，日志写入 logs/app.log 并按大小轮转
# APP_ENV=production
# LOG_LEVEL=info
# LOG_DIR=logs
# LOG_FILENAME=app.log
# LOG_MAX_SIZE_MB=100
# LOG_MAX_BACKUPS=30
# LOG_MAX_AGE_DAYS=30
# LOG_COMPRESS=true
# 开发环境终端彩色日志；NO_COLOR=1 也可关闭
# LOG_COLOR=true

# 配置文件路径，默认 config.yaml
# CONFIG_FILE=config.yaml
